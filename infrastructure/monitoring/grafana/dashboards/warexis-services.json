{
  "uid": "warexis-services",
  "title": "Warexis service resources",
  "description": "All rates use a five-minute window; newly started or idle series may have insufficient samples. Missing/NaN data is unknown, never healthy zero. Counters are process-local observations and reset on restart.",
  "tags": [
    "warexis",
    "provisioned"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "warexis"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "title": "Warexis dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warexis-prometheus"
        },
        "query": "label_values(up{job=~\"warexis-.*\"}, service)",
        "definition": "label_values(up{job=~\"warexis-.*\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "JVM heap used",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (jvm_memory_used_bytes{service=~\"$service\",area=\"heap\"})",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Process CPU fraction",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{service=~\"$service\"}",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Hikari active connections",
      "type": "timeseries",
      "description": "Pool label identifies the bounded datasource pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{service=~\"$service\"}",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Hikari pending connection requests",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{service=~\"$service\"}",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Process uptime",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_uptime_seconds{service=~\"$service\"}",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Business HTTP status rates",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service,status) (rate(http_server_requests_seconds_count{service=~\"$service\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    }
  ]
}
