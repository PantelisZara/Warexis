{
  "uid": "warexis-overview",
  "title": "Warexis overview",
  "description": "All rates use a five-minute window; newly started or idle series may have insufficient samples. Missing/NaN data is unknown, never healthy zero. Counters are process-local observations and reset on restart.",
  "tags": [
    "warexis",
    "provisioned"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "warexis"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "title": "Warexis dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warexis-prometheus"
        },
        "query": "label_values(up{job=~\"warexis-.*\"}, service)",
        "definition": "label_values(up{job=~\"warexis-.*\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape availability (1 reachable / 0 failed)",
      "type": "stat",
      "description": "A missing target is unknown. Zero is a failed scrape, not a business-service diagnosis.",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"warexis-.*\",service=~\"$service\"}",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Business HTTP requests / second",
      "type": "timeseries",
      "description": "Actuator scrapes and health probes are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Business HTTP 5xx / second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\",uri!~\"/actuator.*\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Business HTTP p95 latency",
      "type": "timeseries",
      "description": "No traffic produces no percentile, not zero latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service) (rate(http_server_requests_seconds_bucket{service=~\"$service\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending outbox events (capped)",
      "type": "timeseries",
      "description": "10001 means at least10001 unpublished events; unavailable snapshots are NaN.",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "warexis_outbox_pending{service=~\"$service\"}",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Oldest unpublished outbox age",
      "type": "timeseries",
      "description": "Zero means a successfully observed empty outbox. Check snapshot availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "warexis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "warexis_outbox_oldest_age_seconds{service=~\"$service\"}",
          "legendFormat": "{{service}} {{status}} {{result}} {{stage}} {{pool}}",
          "range": true
        }
      ]
    }
  ]
}
