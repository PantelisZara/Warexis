# Public examples for local development only. Do not use in production.
# Run with: docker compose --env-file .env.example up -d

ORDER_POSTGRES_DB=warexis_order
ORDER_POSTGRES_USER=warexis_order
ORDER_POSTGRES_PASSWORD=order_local_example_only
ORDER_POSTGRES_PORT=15432

INVENTORY_POSTGRES_DB=warexis_inventory
INVENTORY_POSTGRES_USER=warexis_inventory
INVENTORY_POSTGRES_PASSWORD=inventory_local_example_only
INVENTORY_POSTGRES_PORT=15433

FULFILLMENT_POSTGRES_DB=warexis_fulfillment
FULFILLMENT_POSTGRES_USER=warexis_fulfillment
FULFILLMENT_POSTGRES_PASSWORD=fulfillment_local_example_only
FULFILLMENT_POSTGRES_PORT=15434

KAFKA_HOST_PORT=19092
# Public development cluster identifier, not a credential.
# Keep this stable while reusing the Kafka data volume.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Host service messaging is opt-in; set true for the Kafka workflow.
WAREXIS_MESSAGING_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
