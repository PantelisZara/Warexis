# Public frontend configuration only. Never place secrets or tokens here.
VITE_KEYCLOAK_URL=http://127.0.0.1:18080
VITE_KEYCLOAK_REALM=warexis
VITE_KEYCLOAK_CLIENT_ID=warexis-operations
